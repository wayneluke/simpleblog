{% extends 'layout.html.twig' %}
{% block body %}
    <article>
      <h2><a href="{{ path('blog_post', {slug: post.slug}) }}">{{ post.title }}</a></h2>
      <p><small>{{ post.date|date('Y-m-d') }} • in <a href="{{ path('blog_category',{cat:post.category}) }}">{{ post.category }}</a></small></p>
      <p>{{ post.html|raw }}</p>
      <p>
        {% for tag in post.tags %}
          <a href="{{ path('blog_tag',{tag}) }}">#{{ tag }}</a>{% if not loop.last %}, {% endif %}
        {% endfor %}
      </p>
    </article>
{% endblock %}