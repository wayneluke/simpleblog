  {% for post in posts %}
    <article>
      <h2><a href="{{ path('blog_post', {slug: post.slug}) }}">{{ post.title }}</a></h2>
      <p><small>{{ post.date|date('F j, Y') }} • in <a href="{{ path('blog_category',{cat:post.category}) }}">{{ post.category }}</a></small></p>
      <p>{{ post.summary }}</p>
      <p class='tags'>
        {% for tag in post.tags %}
          <a href="{{ path('blog_tag',{tag}) }}">#{{ tag }}</a>{% if not loop.last %}, {% endif %}
        {% endfor %}
      </p>
    </article>
  {% else %}
    <p>No posts yet!</p>
  {% endfor %}